# ─────────────────────────────────────────────────────────────
# API LOMUS · Mercaimpulso — variables de entorno
# Copia este archivo como apps/api/.env para desarrollo local.
# En Render se configuran en el panel (Environment). NUNCA subas el .env al repositorio.
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Puerto HTTP (Render lo asigna solo; en local 4000)
PORT=4000

# Zona horaria del servidor (las fechas de negocio siempre se calculan en hora de Colombia)
TZ=America/Bogota

# Cadena de conexión de MongoDB Atlas (cluster M0).
# Atlas → Database → Connect → Drivers. Incluye usuario, contraseña y nombre de la base.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/mercaimpulso?retryWrites=true&w=majority

# Secretos para firmar las sesiones (JWT). Deben ser DISTINTOS, largos y aleatorios (mín. 16 caracteres).
# Generarlos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-1
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio-2

# Dominio(s) del frontend que pueden llamar a la API, separados por comas (sin "/" al final).
CORS_ORIGIN=http://localhost:5173,https://mercaimpulso.TU-SUBDOMINIO.workers.dev

# Cloudinary (fotos de novedades y góndola). Panel de Cloudinary → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cuenta de administradora que crea `npm run seed` (si ya existe, no se le cambia la contraseña).
ADMIN_USER=carolina
ADMIN_PASSWORD=
# Nombre visible de la administradora (opcional)
ADMIN_NOMBRE=Carolina

# Cloudflare Turnstile (opcional). Si se define, el login exige `turnstileToken` en el cuerpo.
TURNSTILE_SECRET=

# Nivel de logs (opcional): fatal | error | warn | info | debug | silent
LOG_LEVEL=
